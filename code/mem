(--- Memory related words ---)

(example:

Code[ 1 c>C 2 c>C ]Code constant X

X c@  => 1
X 1+ c@ => 2
)

(put next address of code segment on stack)
: Code[ 
	comp:init 
	code.next 
;


(commit the "compiled" code, the start address is still on the stack)
: ]Code 
	comp:done 
;


: .c? (byte --)  (show printable char, or ignore)
	dup 33 <
	over 126 >
	or &1 jmp?
		emit ret
	/1 drop
;


: mem-dump (address count --)
	swap
	/0
		cr 
		dup .hex s" - " .str
		dup c@ .hex  (print as hex)
		s"  " .str
		dup c@ .u    (print unsigned decimal)
		s"  " .str
		dup c@ .c?   (print char if printable)
		
		1+  (address update)
		swap 
		1-  (count update)
		
		(32 emit dup .)
		
		dup 0 == &1 jmp?  (count is 0)
		swap
		&0 jmp
	/1
		2drop
;




(
Create static data, as sequence of bytes, in the code segment. Does
not execute code, only parsing byte values.

Returns two values, the start address and the count.

Handles byte values as hex 0xNN or decimal or binary b1001, as
well as signed.

Ex.

CodeRaw[ 1 2 3 ]CodeRaw

constant Length
constant Start

)


: CodeRaw[
	comp:init
	comp.next   (startAddr)
	
	/1
		readNextWord
		s" ]CodeRaw" nextWordEq &3 jmp?  (--complete--)

		nextWordAtoi not &2 jmp?  (--error--)
		
		(startAddr num)

		(-- write byte --)
		c>C
		(-- repeat --)
		&1 jmp 
		
	/2
		(-- invalid numeric --)
		(startAddr)
		
		drop
		s" cdata( invalid value" .str	
		ret
	/3
		(-- complete --)
		(startAddr)
		comp:done
		dup code.next swap - (startAddr count) (<-- return values)

;




