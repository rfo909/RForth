
40 constant LPAR
41 constant RPAR
32 constant SPACE
59 constant SEMICOLON

variable _ch

: get-next-char key _ch ! ;
: char _ch @ ;


1 constant TOK_ATOM
2 constant TOK_SEXPR
3 constant TOK_RETURN

variable atombuf

(-- pointer to buffer for atom --)
: atom atombuf @ ;

: append 
	char atom atom c@ + 1+ c!
	atom c@ 1+ atom c!
;

: consume-ws
	begin
		char SPACE != ret?
		get-next-char
	again
;


: get-token (--tokType)
	atom c@ 0 == if
		(-- last token was not atom which may mean PAR (or space), so we skip it --)
		get-next-char
	then
	
	0 atom c! (-- clear atom buffer --)
		
	consume-ws
	char LPAR == if TOK_SEXPR ret then
	char RPAR == 
	  char SEMICOLON == or
	    if TOK_RETURN ret then
	begin
		append
		get-next-char
		char LPAR ==
		char RPAR == or
		char SEMICOLON == or
		char SPACE == or if
			TOK_ATOM ret
		then
	again
;


(-- comp-sexpr recursion hack --)
variable comp-sexpr-ptr
: recurse comp-sexpr-ptr @ execute ;



: comp-fn-pre (-- value type)
	get-token 
	dup TOK_ATOM != if
		cr s" Invalid fn type " .str . cr
		ret
	then
	drop
			
	(-- copy into system buffer nextWord --)
	atom nextWord! 
	
	(-- is it an op? --)
	nextWordOp? 
	dup -1 != if
		1 ret    (opcode 1)
	then
	drop
	
	(-- is it a Forth word? --)
	*Dict @ DictLookupNW (DE-pointer) (-- -1 if not found --)
	dup -1 == if
		cr s" Unknown forth word " .str atom .str cr
		drop ret
	then
	0                (DE-pointer 0)
;

: comp-fn-post (value type -- )
	if c>C else DE_compile then
;



: comp-param-atom
	atom nextWord!
	nextWordAtoi if
		CVAL>C
		ret
	then
	drop
	
	*Dict @ DictLookupNW    (DE-pointer) (-- -1 if not found --)
	dup -1 == if
		cr s" Unknown param atom " .str atom .str cr
		drop ret
	then
	DE_compile
;

		
: comp-sexpr
	comp-fn-pre
	
	(-- parameters? --)
	/1
		get-token   (tokenType)
	
		dup TOK_ATOM == if drop comp-param-atom &1 jmp then
		dup TOK_SEXPR == if drop recurse &1 jmp then
		dup TOK_RETURN == if drop comp-fn-post ret then
		cr s" Unknown token type " .str . cr
;

: init
	atombuf @ 0 == if
		HERE atombuf !
		20 allot
	then
	(-- prime single char buffer --)
	SPACE _ch !   
	(-- set the recurse variable --)
	' comp-sexpr comp-sexpr-ptr !
	(-- clear atom buffer --)
	0 atom c!
;


: defun 
	create

	init

	comp:init
	comp.next >R   (R:codeStart)
	0 c>C          (--code length byte--)

	comp-sexpr
	OP_RET c>C

	comp:done 
	
	
	comp.next R@ - 1- 	(codeLength)
		R@ c!		(--set code length --) 
	
	R> 1+ *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
;


((
: alias create
	comp:init
	comp.next   (codeStart)
	readNextWord 
	*Dict @ DictLookupNW DE_compile
	OP_RET c>C
	comp:done 
	
	(codeStart) *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
	;
))

