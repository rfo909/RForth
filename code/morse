(
Morse trainer
--------------

When starting input for a new character, set a value to 1. For every 
dit or dah belonging to the character, shift the value left by 1, and
if a dah, add 1. 

When end of character is detected, call ShowChar with the value
from these calculations, to show the character
--------------
)

60 constant Tick   (length of dit in millis at 20 wpm)

: _data
	s" __ETIANMSURWDKGOHVF_L_PJBXCYZQ__54_3___2__+____16=/___(_7___8_90____________?________.____@______-___________)_____,"
;

115 constant #ch

95 constant UNDERLINE ( _ )

_data 1+ constant CHARS

	
: ShowChar (value --)
	dup #ch > &1 jmp?
		CHARS + c@ emit ret
	/1 
		drop
		UNDERLINE emit
;

