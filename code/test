
40 constant LPAR
41 constant RPAR
32 constant SPACE
59 constant SEMICOLON

variable _ch

: nextChar key _ch ! ;
: char _ch @ ;

variable atombuf


(-- pointer to buffer for atom --)
: atom atombuf @ ;

: clear 0 atom c! ;

: append 
	char atom atom c@ + 1+ c!
	atom c@ 1+ atom c!
;


: consume-ws
	begin
		char SPACE != ret?
		nextChar
	again
;


(-- atom found? --)
: hasAtom atom c@ 0 > ;

(-- char properties --)
: charIsSPACE char SPACE == ;
: charIsLPAR char LPAR == ;
: charIsRPAR char RPAR == char SEMICOLON == or ;

: isPar charIsLPAR charIsRPAR or ;
: isDelimeter charIsSPACE isPar or ;


(-- comp-sexpr recursion hack --)
variable #comp-sexpr
: recurse #comp-sexpr @ execute ;



: comp-fn-pre (-- value type)
	hasAtom not if
		cr s" Expected fn" .str
		ret
	then
	
	(-- copy into system buffer nextWord --)
	atom nextWord! 
	
	(-- is it an op? --)
	nextWordOp? 
	dup 0 >= if
		1 ret 		(opCode 1)
	then
	
	(-- is it a Forth word? --)
	*Dict @ DictLookupNW (DE-pointer) (-- -1 if not found --)
	dup -1 == if
		cr s" Unknown " .str atom .str
		drop ret
	then
	0         	(DE-pointer 0)
;

: comp-fn-post (value type -- )
	if c>C else DE_compile then
;



: comp-param-atom
	atom nextWord!
	nextWordAtoi if
		CVAL>C
		ret
	then
	drop
	
	*Dict @ DictLookupNW    (DE-pointer) (-- -1 if not found --)
	dup -1 == if
		cr s" Unknown " .str atom .str
		drop ret
	then
	DE_compile
;

		

: get-atom
	clear
	consume-ws

	isPar ret?

	(-- collect atom --)
	begin
		append
		nextChar
		isDelimeter break?
	again
;


(-- we are past LPAR when called --)
: comp-sexpr 
	get-atom
	comp-fn-pre
	
	clear
	
	((
	After reading the "fn" atom above, the "char" points to the next
	character, which is either a PAR or SPACE. If it is a PAR, then
	we either recurse or return.
	))
	
	(-- parameters? --)
	/1
		(-- will fail first time, due to clear above --)
		hasAtom if
			comp-param-atom
			clear
		then
	
		charIsRPAR if
			nextChar
			&2 jmp
		then
		charIsLPAR if 
			nextChar 
			recurse
			&1 jmp 
		then
		
		get-atom
		
		&1 jmp
	/2
	  
	(-- about to return --)
	comp-fn-post
;

: init
	atombuf @ 0 == if
		HERE atombuf !
		20 allot
	then
	(-- prime single char buffer --)
	SPACE _ch !   
	(-- set the recurse variable --)
	' comp-sexpr #comp-sexpr !
	
;


: defun 
	create

	init

	comp:init
	comp.next >R   (R:codeStart)
	0 c>C          (--code length byte--)

	comp-sexpr
	OP_RET c>C

	comp:done 
	
	
	comp.next R@ - 1- 	(codeLength)
		R@ c!		(--set code length --) 
	
	R> 1+ *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
;

(-- Examples --)

defun Number + (+ 2 1) 1 ;
defun Show . Number ;
: Mul * ;
defun DoesNotWork . (Mul 3 5) ;
' DoesNotWork dis


((
: alias create
	comp:init
	comp.next   (codeStart)
	readNextWord 
	*Dict @ DictLookupNW DE_compile
	OP_RET c>C
	comp:done 
	
	(codeStart) *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
	;
))

