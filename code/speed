(Updated 2026-08-30)

(compiles to 37 bytes of code)

: prime (n -- bool)
	dup
	(n) 2 /		(counter value, counting down)
	/1
		2dup % 
			0 == &2 jmp?
		(n count) 1-
			dup 1 == &3 jmp?
		&1 jmp
	/2 2drop 0 ret  (divisor found)
	/3 2drop 1  (count reach zero - diviser not found => prime)
;
		


: speedTest1
	[test 31013 prime drop test]
;


: speedTest2 [test 
	1
	/0
		13 prime drop
		1+ dup 4000 > &2 jmp?
		&0 jmp
	/2 drop
	test]
;

((
2026-10-16
---------- 
Wanted to add a more typical test, which loops and conditionally
exits the loop, adding in a few stack ops
))
: speedTest3 [test
	6000 3 2
	begin
		rot 1- dup 0 == break?
		rot rot 
		swap
		dup drop 
		over drop
		3 5 + 2 * drop
	again
	3drop
	test]
;

	
