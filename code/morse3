@@ dictRandom

((
Automatic trainer for recognition (not sending)

))

( NOTE: Removed special characters and numbers !!! )
: Chars
	s" __ETIANMSURWDKGOHVF_L_PJBXCYZQ"
;

Chars c@ constant Len

: Char (pos -- char) Chars + 1+ c@ ;


(-- pins --)
13 constant LED
6 constant BUZZ  (-- must support PWM --)

70 constant Tick  (-- length of dit at 20 wpm is 60 ms --)

: In (pin) IN Pins .setIn ;
: Out (pin) IN Pins .setOut ;

: Dw (value pin) IN Pins .writeDigital ;
: Aw (value pin) IN Pins .writeAnalog ;



: Init
	LED Out
	BUZZ Out
;

: On  
	1 LED Dw 
	60 BUZZ Aw ;

: Off 
	0 LED Dw 
	0 BUZZ Dw ;


(-- play dit or dah, followed by a one dit delay before returning --)
: Play (ticks) 
	On Tick * delay 
	Off
	(-- enforce at least 1 tick delay --)
	Tick delay ;

: PlayChar (pos --)
	1 8 << 	(pos bit)
	
	(-- search for start bit, left to right --)
	/1 

	2dup & not if
		(-- repeat --)
		1 >> 
		dup 0 == if s" NO_START_BIT" .str ret then
		&1 jmp
	then
	
	(-- found start bit --)
	1 >>                 (pos symbol-bit)

	/2
	
	2dup & if 3 Play else 1 Play then
	1 >>
	
	dup 0 == if 2drop ret then
	&2 jmp
;
		
				

: IsChar? (pos -- bool)
	Char 95 !=   (-- not underscore --)
;

: SelectChar
	/1
		IN Random .rand Len %
		dup IsChar? ret?
		drop
		&1 jmp
;


: Main
	Init
	/1
		SelectChar 
		dup PlayChar 4 Tick * delay
		3000 delay 
		Char emit
		1000 delay
		
		key? ret?
		&1 jmp
;
		
