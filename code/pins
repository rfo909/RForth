(
Creating a dictionary with the Pin operations, in order to 
assign meaningful names without prefix Pin.xxx or similar

Example:

D13 IN Pin SetOut
1 D13 IN Pin WriteDigital

To list words in Pin dictionary:

Pin DictWords
)

CDict Pin

: .ddr  (pin) c@ ;
: .port (pin) 1 + c@ ;
: .pin  (pin) 2 + c@ ;
: .mask (pin) 3 + c@ ;


: SetOut (pin)
	dup .ddr		(pin reg)
	swap .mask              (reg mask)
	swap RegOr
;

: SetIn (pin)
	dup .ddr
	swap .mask inv
	swap RegAnd
;


: w0 (pin)
	dup .port swap       (reg pin)
	.mask inv swap RegAnd 
;

: w1 (pin)
	dup .port swap    (reg pin)
	.mask swap RegOr 
;

: PullUp (pin) 
	w1
;


: PullDown (pin)
	w0
;


: WriteDigital (value pin) 
	swap &1 jmp?
		w0 ret
	/1
		(high)
		w1
;

: ReadDigital (pin)
	dup .pin hw@   (pin value)
	swap .mask     (value mask)
	&
;

CDictEnd


