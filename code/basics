(for these, we must temp-store the top value on the data stack, since these words have return addresses)

: RDup 
	R> 
	0 rpick 
	>R 
;


: RSwap
	R> 
	R> R> swap >R >R 
	>R 
;

: LSwap xswap ;

: FSwap xswap ;

: LDup xdup ;

: FDup xdup ;


: RDrop 
	R> 
	R> drop 
	>R 
;

: LDrop xdrop ;

: FDrop xdrop ;

(
--- Push copy of TOS different stacks (L and F share x-stack)
)

(R@ moved to C)

: L@ xdup L> ;

: F@ xdup F> ;


: copy (src target n)
	>R                         (R:n)
	swap                       (target src)
	/0
		R@ 0 == &1 jmp?
		dup c@             (target src char)
		2 pick c!          (target src [char target])
		1+ swap 1+ swap    (target+1 src+1)
		R> 1- >R
		&0 jmp 
	/1
		RDrop 
		2drop
;



(dictionary entry field offsets)

: DE->name (dePtr -- fieldPtr) ;
: DE->type (dePtr -- fieldPtr) 2 + ;	(1 byte)
: DE->address (dePtr -- fieldPtr) 3 + ;
: DE->next (dePtr -- fieldPtr) 5 + ;

(
NOTE: variables are not given any default value as in regular Forth; they are just 
pointers to a cell in the data segment, and are preserved as such, but value
must be initialized by code. Always initialized to 0.
)

: variable (--)
	HERE 
		dup cell allot constant
	0 swap !
;


: immediate
	DE_IMMEDIATE *dictHead DE->type c!
;




(execute a dictionary entry)

: DE_execute (DE -- ...)
	dup DE->type c@ DE_CONSTANT == &1 jmp?
	DE->address @ dcall
	ret
	/1
	DE->address @
;

(compile a dictionary entry)

: DE_compile (DE -- )
	dup DE->type c@ DE_CONSTANT == &1 jmp?

		(compile call as two bytes with high bit set)
		DE->address @

		dup 8 >> 0xFF & 0x80 | comp.out
		0xFF & comp.out
		ret
	
	/1 (constant)
		(compile static value)
		OP_CVAL comp.out
		
		DE->address @
		dup 8 >> 0xFF & comp.out
		0xFF & comp.out 
;
	
	
	

(Ex. 145 123 kL  --- results in 145123 as Long value on xStack)

: kL (kval val -- Lval)
	>L
	>L 1000 >L L* L+
;


(Ex. 123 456 789 mL --- results in 123456789 as Long on xStack)

: mL (mval kval val -- Lval)
	>R kL 
	1000 >L L* R> >L L+
;


: cr 0x0A emit ;

: , HERE cell allot ! ;

: c, HERE 1 allot c! ;


48 constant CH_ZERO
49 constant CH_ONE


: .bit (bool --)
	&1 jmp?  
	CH_ZERO emit ret
	/1 CH_ONE emit
;

: .bits (byte --)
	0x80    (byte bit)
	/0
		dup 0 == &1 jmp?    (exit)
		dup (byte bit bit)
		2 pick & .bit (byte bit)
		1 >>
		&0 jmp
	/1
		2drop
;



34 constant CH_QUOT		(The " character)

(
Create blob (string) of bytes up to the end quote. Only works 
for compile, as it generates code into (net yet allocated) memory
in the code segment. The OP_BLOB executes by reading the length, 
advancing the program pointer past the length byte and the following
bytes, then pushing the address of the length byte on the stack
)
: s" ( -- )
	OP_BLOB comp.out
	
	comp.next >R   (store address of length field)
	0 comp.out    (length field dummy value)
	
	0	(count)
	/0
		key 
		dup 			(count char char)
			CH_QUOT == &2 jmp?   (--- matching quote found)
		(char) comp.out           (count)
		1+
		&0 jmp
	/2
		drop
		R> 
			c!  (patch the length field)
; immediate


: type (ptr count -- )
	swap			(count ptr)
	0			(count ptr n)
	/0
		dup 3 pick == &1 jmp?       (count == n ?)
		dup                         (count ptr n n)
			2 pick + c@ emit
		1+
		&0 jmp
	/1
		3drop
;
			
		
(print forth string starting with length byte)
: .str (str -- ) dup 1+ swap c@ type ;





(bit manipulation in hardware registers)

: RegOr (mask addr) 
	swap over  (addr mask addr)
	hw@        (addr mask value)
	|          (addr newValue)
	swap hw!
;

: RegAnd (mask addr) 
	swap over  (addr mask addr)
	hw@        (addr mask value)
	&          (addr newValue)
	swap hw!
;






