(compiles to 37 bytes of code)

: prime (n -- bool)
	dup
	(n) 2 /		(counter value, counting down)
	/1
		2dup % 
			0 == &2 jmp?
		(n count) 1-
			dup 1 == &3 jmp?
		&1 jmp
	/2 2drop 0 ret  (divisor found)
	/3 2drop 1  (count reach zero - diviser not found => prime)
;
		


: speedTest1
	[test 31013 prime drop test]
;


: speedTest2 [test 
	1
	/0
		13 prime drop
		1+ dup 4000 > &2 jmp?
		&0 jmp
	/2 drop
	test]
;

