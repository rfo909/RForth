(
Reading temperature, controlling fan with PWM
)


10 constant pwmPin

(
154 = ~20 deg C
183 = skin temp
)

: fanInit 
	A0 Pin:in  (also known as D14)
	D10 Pin:out
	0 >F
;


: RA
	14 Pin.readAnalog 150 
;

: CalcPWM 
	RA 
	190 min 150 max - (0-40) 
	6 * (0-240)
	15 + (15-255)
;

: Avg
	xdup 10 >F F/ F-  (subtracted 1/10 from float value)
	CalcPWM	
	>F F+
;

: Calc
	xdup 10 >F F/ F> 15 max
;


: t Avg Calc . ;


: show
	fanInit
	/0
		t
		key? ret?
		1000 delay
		&0 jmp
;
