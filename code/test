((
))

40 constant LPAR
41 constant RPAR
32 constant SPACE
59 constant SEMICOLON

variable _ch

: nextChar key _ch ! ;
: char _ch @ ;

variable atombuf

: init
	atombuf @ 0 == if
		HERE atombuf !
		20 allot
	then
	(-- prime single char buffer --)
	SPACE _ch !   

;

(-- pointer to buffer for atom --)
: atom atombuf @ ;

: clear 0 atom c! ;

: append 
	char atom atom c@ + 1+ c!
	atom c@ 1+ atom c!
;


: consume-ws
	begin
		char SPACE != ret?
		nextChar
	again
;


: isSpace char SPACE == ;
: isLPAR char LPAR == ;
: isRPAR char RPAR == ;
: isSEMICOLON char SEMICOLON == ;

: isSpecial isLPAR isRPAR or isSEMICOLON or ;
: isDelimeter isSpace isSpecial or ;


: getAtom
	clear
	consume-ws
	isSpecial ret?
	begin
		append
		nextChar
		isDelimeter ret?
	again
;

: test init getAtom cr s" |" .str atom .str s" |" .str ;

: isAtom atom c@ ;


(-- parameter atom can be numbers only --)
: comp-param-atom?
	isAtom not if 0 ret then
	
	atom nextWord! nextWordAtoi if
		CVAL>C
	else
		drop
		cr s" Not an int " .str atom .str
		#*Dict @ DictLookupNW DE_compile
	then
	1
;

(-- recursion not really supported, but ... --)
variable #comp-sexpr
: recurse? 
	isLPAR not if 0 ret then 
	s" Recursing " .str cr
	#comp-sexpr @ execute 
	1 
;

(-- we are past LPAR when called --)
: comp-sexpr 
	(-- function name --)
	getAtom

	s" Processing " .str atom .str cr
	
	atom nextWord! 
	
	(-- is it an op? --)
	nextWordOp? 
	dup 0 >= if
		1  		(opCode 1)
	else 
		*Dict @ DictLookupNW (DE-pointer) (-- -1 if not found --)
		dup -1 == if
			cr s" Unknown " .str atom .str
			drop ret
		then
		0         	(DE-pointer 0)
	then
	
	(-- process parameters --)
	begin
		getAtom
		isAtom not break?
		cr s" Parameter '" .str atom .str s" '" .str 
		
		comp-param-atom? not if
			recurse? not break?  (-- RPAR or SEMICOLON --)
		then
	again
	
	(-- generate code for the first atom, which is an op or a dict-entry)  (value flag)
	if
		(-- value is op-code --)
		c>C
	else
		(-- value is DictionaryEntry address --)
		DE_compile
	then
;

(-- set the recurse variable --)


: defun create
	comp:init
	comp.next   (codeStart)
	0 c>C       (--code length byte--)

	init
	
	(-- set recurse pointer --) 
	' comp-sexpr #comp-sexpr !
	comp-sexpr
	OP_RET c>C
	
	comp:done 
	
	
	(codeStart) dup comp.next swap - 1- (codeStart codeLength)
	over c!                             (--set code length --) (codeStart)
	1+                                  (codeStart) (-- actual codeStart --)
	

	
	(codeStart) *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
	;

: alias create
	comp:init
	comp.next   (codeStart)
	readNextWord 
	*Dict @ DictLookupNW DE_compile
	OP_RET c>C
	comp:done 
	
	(codeStart) *dictHead DE->address !
	DE_NORMAL *dictHead DE->type c!
	;


