: copy (src target n)
	>R                         (R:n)
	swap                       (target src)
	/0
		R@ 0 == &1 jmp?
		dup c@             (target src char)
		2 pick c!          (target src [char target])
		1+ swap 1+ swap    (target+1 src+1)
		R> 1- >R
		&0 jmp 
	/1
		RDrop 
		2drop
;



